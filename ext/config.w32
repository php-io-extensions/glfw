ARG_ENABLE("glfw", "enable glfw", "no");

if (PHP_GLFW != "no") {
  EXTENSION("glfw", "glfw.c", null, "-I"+configure_module_dirname);
  ADD_SOURCES(configure_module_dirname + "/kernel", "main.c memory.c exception.c debug.c backtrace.c object.c array.c string.c fcall.c require.c file.c operators.c math.c concat.c variables.c filter.c iterator.c exit.c time.c", "glfw");
  /* PCRE is always included on WIN32 */
  AC_DEFINE("ZEPHIR_USE_PHP_PCRE", 1, "Whether PHP pcre extension is present at compile time");
  if (PHP_JSON != "no") {
    ADD_EXTENSION_DEP("glfw", "json");
    AC_DEFINE("ZEPHIR_USE_PHP_JSON", 1, "Whether PHP json extension is present at compile time");
  }
  
  ADD_SOURCES(configure_module_dirname + "/glfw/glfw/context", "glfwcontext.zep.c", "glfw");
	ADD_SOURCES(configure_module_dirname + "/glfw/glfw/gl", "glfwgl.zep.c", "glfw");
	ADD_SOURCES(configure_module_dirname + "/glfw/glfw", "glfw.zep.c glfwerror.zep.c", "glfw");
	ADD_SOURCES(configure_module_dirname + "/glfw/glfw/input", "glfwinput.zep.c", "glfw");
	ADD_SOURCES(configure_module_dirname + "/glfw/glfw/monitor", "glfwmonitor.zep.c", "glfw");
	ADD_SOURCES(configure_module_dirname + "/glfw/glfw/vulkan", "glfwvulkan.zep.c", "glfw");
	ADD_SOURCES(configure_module_dirname + "/glfw/glfw/window", "glfwwindow.zep.c", "glfw");
  ADD_FLAG("CFLAGS_GLFW", "/D ZEPHIR_RELEASE /Oi /Ot /Oy /Ob2 /Gs /GF /Gy /GL");
  ADD_FLAG("CFLAGS", "/D ZEPHIR_RELEASE /Oi /Ot /Oy /Ob2 /Gs /GF /Gy /GL");
  ADD_FLAG("LDFLAGS", "/LTCG");
}
