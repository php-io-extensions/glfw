{
    "name": "php-io-extensions/glfw",
    "type": "php-ext",
    "description": "1:1 PHP bindings of GLFW 3.4 for staged windows: monitors and video modes, windows, hints, attributes and callbacks, events, contexts, Vulkan surfaces and native handles",
    "keywords": [
        "glfw",
        "window",
        "opengl",
        "vulkan",
        "php-ext"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Project Saturn Studios, LLC",
            "email": "info@projectsaturnstudios.com"
        }
    ],
    "require": {
        "php": ">=8.4"
    },
    "require-dev": {
        "pestphp/pest": "^4.0"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.10.x-dev"
        }
    },
    "php-ext": {
        "extension-name": "glfw",
        "priority": 30,
        "support-zts": true,
        "support-nts": true,
        "os-families": [
            "linux",
            "darwin"
        ],
        "configure-options": [
            {
                "name": "enable-glfw",
                "description": "Enable the glfw extension",
                "needs-value": false
            }
        ]
    }
}
